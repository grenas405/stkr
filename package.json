{
  "name": "stkr",
  "version": "0.1.0",
  "description": "STKR (pronounced stalker): local-first radar maps of what you like",
  "scripts": {
    "fetch-model": "node scripts/fetch-model.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run check && npm run build && wrangler deploy",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test && npm audit --omit=dev",
    "e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grenas405/stkr.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/grenas405/stkr/issues"
  },
  "homepage": "https://github.com/grenas405/stkr#readme",
  "private": true,
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@huggingface/transformers": "4.3.2",
    "animejs": "4.5.0",
    "d3-force": "3.0.1",
    "idb": "8.0.4",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@playwright/test": "1.64.1",
    "@types/d3-force": "3.0.10",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.14",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1",
    "wrangler": "4.157.0"
  }
}
